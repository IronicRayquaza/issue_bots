# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=
# Channel the bot watches for error reports (right-click channel -> Copy Channel ID)
ERROR_CHANNEL_ID=
# Your own Discord user ID; new-issue drafts are DMed here
MAINTAINER_USER_ID=

# --- Anthropic (Claude) ----------------------------------------------------
# API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# --- GitHub ----------------------------------------------------------------
# Repository to search, in owner/repo form
GITHUB_REPO=owner/repo-name
# Fine-grained PAT with read-only "Issues" access to the repo above.
# Required for private repos; strongly recommended for public ones
# (unauthenticated search is limited to 10 requests/minute).
GITHUB_TOKEN=
