# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=
# Channel the bot watches for error reports (right-click channel -> Copy Channel ID)
ERROR_CHANNEL_ID=
# Your own Discord user ID; new-issue drafts and sync alerts are DMed here
MAINTAINER_USER_ID=

# --- Anthropic (Claude) ----------------------------------------------------
# API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# --- GitHub ----------------------------------------------------------------
# Your fork, in owner/repo form. This is the repo the bot keeps in sync.
GITHUB_FORK_REPO=your-username/ods
# Optional: the original repo to search for issues/PRs. If unset, it's read
# from the fork's parent on GitHub.
# GITHUB_UPSTREAM_REPO=original-owner/ods
# Branch on the fork to sync from the same branch upstream (default: main)
# FORK_BRANCH=main
# How often to sync the fork in the background (default: 10)
# SYNC_INTERVAL_MINUTES=10
# Fine-grained PAT scoped to your fork with:
#   Contents: Read and write   (to sync the fork)
#   Workflows: Read and write  (only needed if upstream changes .github/workflows)
# Public upstream repos are searchable with any token.
GITHUB_TOKEN=
